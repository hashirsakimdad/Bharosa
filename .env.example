# ---------- AI (free) ----------
# Get a free key at https://aistudio.google.com/apikey  (no billing needed)
GEMINI_API_KEY=
# Main model and a fallback used when the main one is rate-limited (HTTP 429)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Set to false to save free-tier quota: explanations then come from built-in templates
EXPLAIN_WITH_LLM=true

# ---------- PayPal (sandbox, free) ----------
# https://developer.paypal.com/dashboard/applications/sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Where PayPal sends the buyer back after paying
APP_URL=http://localhost:3000

# PayPal does not support PKR/AED/SAR/INR. Prices in these are converted to USD
# for the sandbox pay link. Approximate demo rates, update before demo day.
FX_TO_USD={"PKR":0.0036,"INR":0.012,"AED":0.2723,"SAR":0.2667}

# ---------- Supabase ----------
# Project Settings -> API. Service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WhatsApp (Twilio sandbox, free) ----------
# console.twilio.com -> Messaging -> Try it out -> Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number, with the whatsapp: prefix
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact public URL you paste into Twilio's "When a message comes in" box.
# Needed for signature checks behind tunnels/proxies, e.g. https://abc123.ngrok-free.app/api/whatsapp
TWILIO_WEBHOOK_URL=
# Local testing only: skip the Twilio signature check. Ignored in production.
TWILIO_SKIP_SIGNATURE=false

# ---------- Security ----------
# Secret salt for hashing phone numbers / handles before saving. Make it long and random:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after launch, or old reports stop matching.
HASH_SALT=
# Checks allowed per IP per minute (protects your free AI quota)
RATE_LIMIT_PER_MINUTE=10

# ---------- Optional, free ----------
# Google Safe Browsing (free key from Google Cloud console). Leave empty to skip.
SAFE_BROWSING_API_KEY=
